[gd_resource type="Resource" script_class="StoryLog" format=3]

[ext_resource type="Script" path="res://scripts/data/story_log.gd" id="1"]

[resource]
script = ExtResource("1")
id = "prologue"
title = "熔炉苏醒"
chapter = "序章"
body = "熔炉在沉眠中苏醒，第一缕火光刺破万古的黑暗。
地脉深处传来低沉的搏动，像一颗迟来的心跳，震得焦土簌簌落下。
熔岩巨像拖着笨重的身躯破土而出，所过之处岩石熔作赤河。
你第一次听见熔核的呼唤——它醒了，而蛰伏于裂痕中的危机，也随之苏醒。
守炉人的契约在胸口发烫：只要熔核不灭，你便不能退后半步。"
unlock_level_id = "level_01"
