[gd_resource type="Resource" script_class="StoryLog" format=3]

[ext_resource type="Script" path="res://scripts/data/story_log.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ch2"
title = "锻炉遗迹"
chapter = "第二章"
body = "锻炉的废墟之下，古老的封印早已松动，像一根绷到极限的弦。
深渊领者自最深的裂痕爬出，庞大的身躯几乎塞满整条甬道，半血之后便会彻底狂暴，将焦土化为炼狱。
它每踏出一步，熔核的搏动就急促一分，仿佛认出了这位不速之客。
你忽然生出一个念头：这些裂痕、这些怪物，或许从来不是偶然——它们都在奔向同一个地方。
这是终局的前奏，而你，正站在终局的门口。"
unlock_level_id = "level_03"
