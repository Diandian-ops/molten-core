[resource]
script = ExtResource("1_wbpiy")
id = "epilogue"
title = "锻炉重燃"
chapter = "尾声"
body = "深渊领者倒下，裂痕缓缓愈合。
熔核重新归于平稳的灼热，光，再一次覆盖了这片土地。
你望向远方尚未熄灭的余烬——守炉人的故事，还未结束。"
unlock_level_id = "level_03"
