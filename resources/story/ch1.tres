[gd_resource type="Resource" script_class="StoryLog" format=3]

[ext_resource type="Script" path="res://scripts/data/story_log.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ch1"
title = "地脉裂痕"
chapter = "第一章"
body = "地脉在某处撕裂，暗紫色的裂隙向外吐出扭曲的影。
暗影行者穿行于光与暗之间，时隐时现，利爪所及晶簇尽碎。
它们不似野兽般盲目——每一次迂回、每一次突进，都像在试探熔核的薄弱之处。
你终于明白，这不再是偶然的入侵，而是一场有预谋的渗透。
裂痕之后，似乎有一双眼睛，正静静打量着这片将熄未熄的火。"
unlock_level_id = "level_02"
