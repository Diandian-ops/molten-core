# ============================================================
# Godot 4 + macOS .gitignore (严谨版)
# ============================================================

# ── Godot 自动生成的缓存/索引 (绝不能进版本控制) ──
.godot/
.import/
android/            # Android Studio 工程
.android/
ios/                # iOS Xcode 工程
*.translation

# ── 导出产物 (build 是构建产物,体积大且可重生成) ──
build/

# ── Godot 工具生成的项目级临时文件 ──
*.translation
.editorconfig  # (如果只是本地编辑器配置)
*.tmp

# ── macOS 系统文件 ──
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE / 编辑器配置 (项目级不分享) ──
.vscode/
.idea/
*.swp
*.swo
*~
.fleet/
.rider/
*.sublime-project
*.sublime-workspace

# ── Python 工具脚本留下的缓存 ──
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# ── aionui / 本地工具配置 ──
.aionrs/

# ── 节点版工具 (如 Volta/nvm) ──
.node_modules/
node_modules/

# ── 调试/测试临时文件 ──
test_*.gd
debug_*.gd

# ── 玩家存档 (运行时产物,不进版本控制) ──
# 注意: GameManager 用 user://, 默认在 ~/.local/share/godot/app_userdata/.../
# 不在项目目录里,所以不需特别处理

# ============================================================
# ✅ 以下应该进版本控制
# ============================================================
# *.gd           GDScript 源码
# *.tscn         场景文件
# *.tres         资源数据
# *.gdshader     着色器
# project.godot  项目配置
# export_presets.cfg  导出预设
# addons/        插件
# assets/        美术/音频 (虽然大,但已压缩)
